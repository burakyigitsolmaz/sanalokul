Options -Indexes
DirectoryIndex index.php

AddDefaultCharset UTF-8

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# Hata sayfaları
ErrorDocument 403 /sanalokul/403.php
ErrorDocument 404 /sanalokul/404.php

# Nokta ile başlayan dosyalara (ör. .git, .env) erişimi kapat
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Yardımcı dosyalara doğrudan erişimi kapat
<FilesMatch "^(kurulum|README|composer)\.(php|md|json|lock)$">
    Require all denied
</FilesMatch>
